# All client-side requests use a relative URL — they go to Next.js /api/v1/*
# which is reverse-proxied to INTERNAL_API_URL on the server side.
# The browser never talks directly to the backend or gateway.
NEXT_PUBLIC_API_URL="/api/v1"

# Server-side proxy target — point this to the API Gateway, not the backend directly.
# Local dev: http://localhost:8000/api/v1
# Production (k8s): http://api-gateway-service/api/v1
INTERNAL_API_URL="http://localhost:8000/api/v1"

NEXTAUTH_SECRET=supersecret

# WebSocket connects directly to the NestJS backend (gateway does not proxy WS).
NEXT_PUBLIC_SOCKET_URL="http://localhost:3012"

# Omise public key (safe to expose — used in browser for card tokenisation)
NEXT_PUBLIC_OMISE_PUBLIC_KEY="pkey_test_xxxxxxx"

DOMAIN="localhost"
NODE_ENV="production"
PORT=3022

# Deployment zone — local | dev | prod
NEXT_PUBLIC_ZONE=local
